<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true"
        android:color="@color/dark_number_onpress_foreground"   >

        <shape >
            <corners  android:radius="500000dp"/>
            <solid android:color="@color/dark_number_onpress_background" />
        </shape>

    </item> <!-- pressed -->


    <item android:color="@color/dark_number_foreground" >

        <shape >
            <corners  android:radius="500000dp"/>
            <solid android:color="@color/dark_number_background" />

        </shape>

    </item> <!-- focused -->

</selector>

